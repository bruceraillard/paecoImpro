{
  "name": "impro-multijoueur",
  "version": "1.1.0",
  "description": "Jeu d'impro multijoueur (contrôleur + projecteur) en Electron",
  "author": "Bruce Raillard",
  "license": "MIT",
  "main": "main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron .",
    "test": "node --test",
    "check": "node --check main.js && node --check app/shared/game-state.js && node --check app/control/control.js && node --check app/projector/projector.js && node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "fr.paeco.impro",
    "productName": "Paeco Impro",
    "copyright": "Copyright © 2026 Bruce Raillard",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "app/**",
      "main.js",
      "package.json",
      "node_modules/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icons/icon.icns",
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    },
    "publish": null
  }
}
